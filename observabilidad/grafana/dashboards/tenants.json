          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#2DD4BF"
              },
              {
                "value": 1,
                "color": "#FB7185"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 24,
      "type": "stat",
      "title": "Telemetría del colector",
      "gridPos": {
        "x": 18,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "description": "Requiere que el scrape y el colector estén disponibles y que el último ciclo tenga como máximo 180 segundos.",
      "datasource": {
        "type": "prometheus",
        "uid": "pfm2-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(0 * ((max(up{job=\"pfm2\"}) == 1) and on() (max(pfm2_colector_ok{job=\"pfm2\"}) == 1) and on() ((time() - max(pfm2_colector_timestamp_seconds{job=\"pfm2\"})) <= 180)) + 1) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series",
