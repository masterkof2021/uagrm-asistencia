    {
      "id": 1,
      "type": "state-timeline",
      "title": "Historial de salud por capa",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 16,
        "h": 10
      },
      "description": "Verde: operativo. Rosa: caído con muestra válida. Ámbar: sonda sin señal útil. Los huecos indican ausencia de series o del colector. Frontend comprueba Nginx, backend el servicio Node.js y database MySQL.",
      "datasource": {
        "type": "prometheus",
        "uid": "pfm2-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((pfm2_servicio_up{job=\"pfm2\",entorno=~\"${entorno:regex}\",tenant=~\"${tenant:regex}\"} and on(tenant, entorno, rol) (pfm2_muestra_up{job=\"pfm2\",entorno=~\"${entorno:regex}\",tenant=~\"${tenant:regex}\"} == 1))\nor on(tenant, entorno, rol) (2 + 0 * pfm2_muestra_up{job=\"pfm2\",entorno=~\"${entorno:regex}\",tenant=~\"${tenant:regex}\"}))\nand on() ((max(up{job=\"pfm2\"}) == 1) and on() (max(pfm2_colector_ok{job=\"pfm2\"}) == 1) and on() ((time() - max(pfm2_colector_timestamp_seconds{job=\"pfm2\"})) <= 180))",
          "legendFormat": "{{tenant}} · {{rol}}",
          "instant": false,
          "range": true,
          "format": "time_series",
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "pfm2-prometheus"
          }
        }
      ],
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "center",
        "rowHeight": 0.78,
