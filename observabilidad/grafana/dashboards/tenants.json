{
  "uid": "pfm2-tenants",
  "title": "Salud de tenants · UAGRM Asistencia",
  "schemaVersion": 39,
  "version": 2,
  "timezone": "America/La_Paz",
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "entorno",
        "label": "Entorno",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "pfm2-prometheus"
        },
        "query": "label_values(pfm2_muestra_up{job=\"pfm2\"}, entorno)",
        "definition": "label_values(pfm2_muestra_up{job=\"pfm2\"}, entorno)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "pfm2-prometheus"
        },
        "query": "label_values(pfm2_muestra_up{job=\"pfm2\",entorno=~\"${entorno:regex}\"}, tenant)",
        "definition": "label_values(pfm2_muestra_up{job=\"pfm2\",entorno=~\"${entorno:regex}\"}, tenant)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 20,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "transparent": true,
      "options": {
        "mode": "markdown",
        "content": "## UAGRM Asistencia · Centro de operaciones\nCompara instituciones con **Entorno** y **Tenant**. Consulta primero el estado actual y usa el historial para ubicar el inicio de una incidencia."
      }
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Tenants con telemetría",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "description": "Instituciones distintas que emiten al menos una serie de muestreo, incluso si alguna sonda no responde.",
      "datasource": {
        "type": "prometheus",
        "uid": "pfm2-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(count(count by (tenant, entorno) (pfm2_muestra_up{job=\"pfm2\",entorno=~\"${entorno:regex}\",tenant=~\"${tenant:regex}\"})) or vector(0))\nand on() ((max(up{job=\"pfm2\"}) == 1) and on() (max(pfm2_colector_ok{job=\"pfm2\"}) == 1) and on() ((time() - max(pfm2_colector_timestamp_seconds{job=\"pfm2\"})) <= 180))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series",
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "pfm2-prometheus"
          }
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "valueSize": 34
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "Sin datos",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#94A3B8"
              },
              {
                "value": 1,
                "color": "#60A5FA"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Capas operativas",
      "gridPos": {
        "x": 6,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "description": "Proporción de capas observadas con una muestra válida y estado operativo. Las sondas sin señal se incluyen en el total.",
      "datasource": {
        "type": "prometheus",
        "uid": "pfm2-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((count((pfm2_servicio_up{job=\"pfm2\",entorno=~\"${entorno:regex}\",tenant=~\"${tenant:regex}\"} and on(tenant, entorno, rol) (pfm2_muestra_up{job=\"pfm2\",entorno=~\"${entorno:regex}\",tenant=~\"${tenant:regex}\"} == 1)) == 1) or (0 * count(pfm2_muestra_up{job=\"pfm2\",entorno=~\"${entorno:regex}\",tenant=~\"${tenant:regex}\"}))) / count(pfm2_muestra_up{job=\"pfm2\",entorno=~\"${entorno:regex}\",tenant=~\"${tenant:regex}\"}))\nand on() ((max(up{job=\"pfm2\"}) == 1) and on() (max(pfm2_colector_ok{job=\"pfm2\"}) == 1) and on() ((time() - max(pfm2_colector_timestamp_seconds{job=\"pfm2\"})) <= 180))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series",
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "pfm2-prometheus"
          }
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "valueSize": 34
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "noValue": "Sin datos",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#FB7185"
              },
              {
                "value": 0.01,
                "color": "#FBBF24"
              },
              {
                "value": 1,
                "color": "#2DD4BF"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 23,
      "type": "stat",
      "title": "Alertas activas",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "description": "Reglas de Prometheus en estado firing para la selección. Incluye la alerta global del colector.",
      "datasource": {
        "type": "prometheus",
        "uid": "pfm2-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(ALERTS{alertstate=\"firing\",tenant!=\"\",entorno=~\"${entorno:regex}\",tenant=~\"${tenant:regex}\"}\nor ALERTS{alertstate=\"firing\",alertname=\"ColectorNoDisponible\"}) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series",
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "pfm2-prometheus"
          }
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "valueSize": 34
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "Sin datos",
          "color": {
            "mode": "thresholds"
