    {
      "id": 26,
      "type": "stat",
      "title": "API vía Nginx",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 4
      },
      "description": "Estado de /api/me por institución. La sonda espera HTTP 401 sin sesión. Cuando falta la sonda de API y consta que Nginx está caído, el acceso también figura como caído. Las demás ausencias aparecen como sin señal.",
      "datasource": {
        "type": "prometheus",
        "uid": "pfm2-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((pfm2_api_up{job=\"pfm2\",entorno=~\"${entorno:regex}\",tenant=~\"${tenant:regex}\",rol=\"frontend\"} and on(tenant, entorno, rol) (pfm2_muestra_up{job=\"pfm2\",entorno=~\"${entorno:regex}\",tenant=~\"${tenant:regex}\",rol=\"frontend\"} == 1))\nor on(tenant, entorno, rol) ((pfm2_servicio_up{job=\"pfm2\",entorno=~\"${entorno:regex}\",tenant=~\"${tenant:regex}\",rol=\"frontend\"} == 0) and on(tenant, entorno, rol) (pfm2_muestra_up{job=\"pfm2\",entorno=~\"${entorno:regex}\",tenant=~\"${tenant:regex}\",rol=\"frontend\"} == 1))\nor on(tenant, entorno, rol) (2 + 0 * pfm2_muestra_up{job=\"pfm2\",entorno=~\"${entorno:regex}\",tenant=~\"${tenant:regex}\",rol=\"frontend\"}))\nand on() ((max(up{job=\"pfm2\"}) == 1) and on() (max(pfm2_colector_ok{job=\"pfm2\"}) == 1) and on() ((time() - max(pfm2_colector_timestamp_seconds{job=\"pfm2\"})) <= 180))",
