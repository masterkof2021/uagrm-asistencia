          "expr": "(count(((pfm2_servicio_up{job=\"pfm2\",entorno=~\"${entorno:regex}\",tenant=~\"${tenant:regex}\"} and on(tenant, entorno, rol) (pfm2_muestra_up{job=\"pfm2\",entorno=~\"${entorno:regex}\",tenant=~\"${tenant:regex}\"} == 1))\nor on(tenant, entorno, rol) (2 + 0 * pfm2_muestra_up{job=\"pfm2\",entorno=~\"${entorno:regex}\",tenant=~\"${tenant:regex}\"})) == 1) or (0 * count(pfm2_muestra_up{job=\"pfm2\",entorno=~\"${entorno:regex}\",tenant=~\"${tenant:regex}\"})))\nand on() ((max(up{job=\"pfm2\"}) == 1) and on() (max(pfm2_colector_ok{job=\"pfm2\"}) == 1) and on() ((time() - max(pfm2_colector_timestamp_seconds{job=\"pfm2\"})) <= 180))",
          "legendFormat": "Operativo",
