{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConsultarEventosDelStackDelLab",
      "Effect": "Allow",
      "Action": "cloudformation:DescribeStackEvents",
      "Resource": "arn:aws:cloudformation:us-east-2:487450071663:stack/asistencia-cfn-lab/*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "us-east-2"}}
    },
    {
      "Sid": "AdministrarSoloBucketsDeAuditoriaDelLab",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket", "s3:DeleteBucket", "s3:ListBucket", "s3:ListBucketVersions", "s3:GetBucketLocation",
        "s3:GetBucketAcl", "s3:GetBucketPolicy", "s3:PutBucketPolicy", "s3:DeleteBucketPolicy",
        "s3:GetBucketTagging", "s3:PutBucketTagging",
        "s3:GetEncryptionConfiguration", "s3:PutEncryptionConfiguration",
        "s3:GetBucketVersioning", "s3:PutBucketVersioning",
        "s3:GetLifecycleConfiguration", "s3:PutLifecycleConfiguration",
        "s3:GetBucketLogging", "s3:PutBucketLogging",
        "s3:GetBucketPublicAccessBlock", "s3:PutBucketPublicAccessBlock",
        "s3:GetBucketOwnershipControls", "s3:PutBucketOwnershipControls"
      ],
      "Resource": [
        "arn:aws:s3:::asistencia-cfn-lab-flowlogs-487450071663-us-east-2",
        "arn:aws:s3:::asistencia-cfn-lab-accesslogs-487450071663-us-east-2"
      ],
      "Condition": {"StringEquals": {"aws:RequestedRegion": "us-east-2"}}
    },
    {
      "Sid": "EntregaDeLogsEnOhio",
      "Effect": "Allow",
      "Action": ["logs:CreateLogDelivery", "logs:DeleteLogDelivery", "logs:GetLogDelivery", "logs:ListLogDeliveries"],
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "us-east-2"}}
    },
    {
      "Sid": "LeerSoloRegistrosDelLab",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::asistencia-cfn-lab-flowlogs-487450071663-us-east-2/AWSLogs/487450071663/*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "us-east-2"}}
    }
  ]
}
